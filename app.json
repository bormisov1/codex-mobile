{
  "expo": {
    "name": "Modex",
    "slug": "codex-mobile",
    "scheme": "modex",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.prototypebyai.modex",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "Speech dictation for messages to your Codex server.",
        "NSPhotoLibraryUsageDescription": "Select photos to attach to messages in Modex.",
        "NSSpeechRecognitionUsageDescription": "Transcribe your speech into a message."
      }
    },
    "android": {
      "package": "com.prototypebyai.codexmobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14221d"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-speech-recognition",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14221d"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4e0c530e-5a70-4baf-a4ac-e864ebfef37d"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "bormisov"
  }
}
