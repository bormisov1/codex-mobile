{
  "name": "codex-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "preview:web": "node scripts/serve-web-preview.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mjs",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.17.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "markdown-it": "14.3.1",
    "linkify-it": "6.1.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
